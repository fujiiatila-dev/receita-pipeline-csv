# ----- ClickHouse externo (fonte de dados em producao) -----
CLICKHOUSE_HOST=177.67.54.126
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=empresas_ativas_do_brasil
CLICKHOUSE_SECURE=false

# ----- MinIO dedicado do receita -----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ----- Airflow -----
AIRFLOW_UID=50000
AIRFLOW_ADMIN_PASSWORD=admin

# ----- Nominatim -----
NOMINATIM_PASSWORD=changeme
NOMINATIM_PBF_URL=https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/south-america/brazil-updates/
NOMINATIM_IMPORT_THREADS=4

# ----- Geocoding worker -----
WORKER_THREADS=8
WORKER_BATCH_SIZE=5000
WORKER_FLUSH_EVERY=1000
WORKER_IDLE_SLEEP=300
WORKER_REPROCESS_IBGE=false

# ----- DAG mensal: tasks de geocoding (off por default na VPS, worker dedicado faz o trabalho) -----
GEOCODING_PROVIDER=off
GEOCODING_BATCH_LIMIT=1000
GEOCODING_FLUSH_EVERY=500
CLEANUP_GEO_MIN_THRESHOLD=10000000
